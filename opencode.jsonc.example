{
  "$schema": "https://opencode.ai/config.json",
  // 主对话模型
  "model": "litellm/deepseek-v4-pro",
  // 图片/视觉模型
  "image_model": "litellm/vertex_ai/gemini-3.1-pro-preview",
  // 为 title 生成单独指定模型（默认会回退到主模型，这里显式复用主模型）
  "agents": {
    "title": {
      "model": "litellm/deepseek-v4-pro"
    }
  },
  "providers": {
    "litellm": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        // 替换为你的 litellm / openai-compatible 网关地址
        "baseURL": "https://your-lite-llm-gateway.example.com",
        // 替换为你的 API Key（用 {env:OPENCODE_API_KEY} 引用环境变量更安全）
        "apiKey": "{env:OPENCODE_API_KEY}"
      },
      "models": {
        "vertex_ai/gemini-3.1-pro-preview": {
          "name": "gemini-3.1-pro-preview",
          "capabilities": {
            "input": ["text", "image", "pdf"]
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "capabilities": {
            "input": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 393216
          }
        },
        "glm-5.3": {
          "name": "glm-5.3",
          "capabilities": {
            "input": ["text", "image", "pdf"]
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "deepseek-v4-flash-vision-exp": {
          "name": "deepseek-v4-flash-vision-exp",
          "capabilities": {
            "input": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "capabilities": {
            "input": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 393216
          }
        },
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "capabilities": {
            "input": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 393216
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--browserUrl=http://127.0.0.1:9222"
        ]
      }
    }
  }
}
